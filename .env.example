# Copy to the gitignored root .env; Prisma/backend already load this root file.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
POSTGRES_USER=hopebridge_local
POSTGRES_PASSWORD=replace-with-your-local-random-password
POSTGRES_DB=hopebridge_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql://hopebridge_local:replace-with-your-local-random-password@127.0.0.1:5432/hopebridge_dev
# Encode reserved URL characters in passwords; changing env does not reset existing volumes.
# Existing Vite proxy is same-origin; this is reserved configuration, not implemented CORS.
CORS_ORIGIN=http://localhost:5173
# Exact browser Origin values accepted by staff authentication (no wildcards).
# Production must explicitly set HTTPS origins for its same-origin deployment.
AUTH_TRUSTED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:3000
# Local Mailpit capture only; no SMTP sender/notification/recovery code exists yet.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=HopeBridge Local <no-reply@hopebridge.test>
MAILPIT_HTTP_PORT=8025
MAILPIT_SMTP_PORT=1025
# For a future approved production mailer: use deployment secrets, never commit values.
# SMTP_HOST=<provider-smtp-host>
# SMTP_PORT=<provider-port>
# SMTP_SECURE=<true-or-false-per-provider>
# SMTP_USER=<deployment-secret>
# SMTP_PASSWORD=<deployment-secret>
# SMTP_FROM=<verified-sender>
# A containerized app uses SMTP_HOST=mailpit, not host loopback.
# AUTH-002 reset stays Super Admin-only; no credential emails or self-service recovery.
