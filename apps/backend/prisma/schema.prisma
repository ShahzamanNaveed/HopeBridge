  revision    CmsRevision @relation("CmsPublication_revision", fields: [revisionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("cms_publications")
}

model AuditEvent {
  id                     String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  actorKind              AuditActorKind     @map("actor_kind")
  systemActor            String?            @map("system_actor")
  domain                 String
  action                 String
  entityType             String             @map("entity_type")
  entityId               String             @map("entity_id")
  before                 Json?              @db.JsonB
  after                  Json?              @db.JsonB
  metadata               Json?              @db.JsonB
  reportTransition_audit ReportTransition[] @relation("ReportTransition_audit")
  actorId                String?            @map("actor_id") @db.Uuid
  actor                  StaffUser?         @relation("AuditEvent_actor", fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  branchId               String?            @map("branch_id") @db.Uuid
  branch                 Branch?            @relation("AuditEvent_branch", fields: [branchId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([branchId, createdAt])
  @@index([domain, createdAt])
  @@index([entityType, entityId, createdAt])
  @@map("audit_events")
}
