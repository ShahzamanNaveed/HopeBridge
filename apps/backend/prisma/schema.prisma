  number                  Int
  status                  ContentRevisionStatus @default(DRAFT)
  titleEn                 String?               @map("title_en")
  titleUr                 String?               @map("title_ur")
  summaryEn               String?               @map("summary_en")
  summaryUr               String?               @map("summary_ur")
  bodyEn                  String?               @map("body_en")
  bodyUr                  String?               @map("body_ur")
  startsAt                DateTime?             @map("starts_at") @db.Timestamptz(3)
  endsAt                  DateTime?             @map("ends_at") @db.Timestamptz(3)
  location                String?
  sanitizedAt             DateTime?             @map("sanitized_at") @db.Timestamptz(3)
  publishedAt             DateTime?             @map("published_at") @db.Timestamptz(3)
  itemId                  String                @map("item_id") @db.Uuid
